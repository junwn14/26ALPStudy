N = int(input())
height = list(map(int, input().split()))

stack = []
result = []

for i in range(N):
    while stack and stack[-1][1] < height[i]:
        stack.pop()

    if stack:
        result.append(stack[-1][0] + 1)
    else:
        result.append(0)

    stack.append((i, height[i]))

print(*result)
